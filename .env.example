# Copy this file to .env and fill in your own values

# MySQL connection (your local machine)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=crousty_tac
# Set to true when connecting to a cloud MySQL host (e.g. Aiven) that
# requires SSL. Leave as false for a plain local MySQL install.
DB_SSL=false

# App
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
BASE_URL=http://localhost:3000

# --- Placeholders for later (not required to run the app) ---
# Payment gateway (e.g. Stripe or SumUp) - see server/utils/payment.js
PAYMENT_PROVIDER_API_KEY=

# SMS provider (e.g. Twilio) - see server/utils/sms.js
SMS_PROVIDER_API_KEY=
