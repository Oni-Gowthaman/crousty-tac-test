<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head') %>
</head>
<body class="admin">
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { active: 'orders' }) %>
    <div class="main">
      <div class="page-head">
        <div>
          <h1>Orders &amp; Payments</h1>
          <p>Every order — items, dips/drinks, price breakdown, cooking instructions, and time to ready.</p>
        </div>
      </div>

      <div class="panel">
        <% if (!orders.length) { %>
          <div class="empty">No orders yet.</div>
        <% } else { %>
          <table class="data-table">
            <thead>
              <tr><th>Order</th><th>Table</th><th>Customer</th><th>Total</th><th>Breakdown</th><th>Status</th><th>Payment</th><th>Instructions</th><th>Placed → Ready</th></tr>
            </thead>
            <tbody>
              <% orders.forEach(function(o) { %>
                <tr>
                  <td><%= o.order_code %></td>
                  <td><%= o.is_counter ? 'Takeaway (counter)' : 'Table ' + o.table_number %><br><span style="color:#8a7f70; font-size:11px; text-transform:capitalize;"><%= o.dining_option.replace('_',' ') %></span></td>
                  <td><%= o.customer_name %><br><span style="color:#8a7f70; font-size:11.5px;"><%= o.mobile_number %></span></td>
                  <td><b>€<%= Number(o.total_amount).toFixed(2) %></b></td>
                  <td style="font-size:11px; color:#8a7f70;">
                    Sub €<%= Number(o.subtotal).toFixed(2) %><br>
                    <% if (o.discount_amount > 0) { %>Disc -€<%= Number(o.discount_amount).toFixed(2) %><br><% } %>
                    <% if (o.tax_amount > 0) { %>Tax €<%= Number(o.tax_amount).toFixed(2) %><br><% } %>
                    <% if (o.charge_amount > 0) { %>Charge €<%= Number(o.charge_amount).toFixed(2) %><% } %>
                  </td>
                  <td><span class="badge <%= o.status %>"><%= o.status %></span></td>
                  <td style="text-transform:uppercase; font-size:11.5px;"><%= o.payment_mode_label %></td>
                  <td style="max-width:160px; font-size:11.5px;"><%= o.special_instructions || '—' %></td>
                  <td style="font-size:11.5px; color:#8a7f70;">
                    <%= new Date(o.created_at).toLocaleString() %><br>
                    <% if (o.ready_at) { %>→ <%= new Date(o.ready_at).toLocaleTimeString() %><% } else { %>→ —<% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
