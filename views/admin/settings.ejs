<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head') %>
</head>
<body class="admin">
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { active: 'settings' }) %>
    <div class="main">
      <div class="page-head">
        <div>
          <h1>Tax & Charges</h1>
          <p>Set once here — applied automatically to every order's price breakdown from now on.</p>
        </div>
      </div>

      <% if (saved) { %><div class="flash">Settings saved.</div><% } %>

      <div class="panel">
        <form method="POST" action="/admin/settings">
          <div class="form-grid">
            <div class="field">
              <label>Tax (%)</label>
              <input type="number" step="0.1" min="0" max="100" name="tax_percent" value="<%= settings.tax_percent %>">
            </div>
            <div class="field">
              <label>Service charge (%)</label>
              <input type="number" step="0.1" min="0" max="100" name="service_charge_percent" value="<%= settings.service_charge_percent %>">
            </div>
            <div class="field full">
              <label>Restaurant address (shown on the customer app's front page)</label>
              <input type="text" name="address" value="<%= settings.address %>">
            </div>
            <div class="field full">
              <label>Restaurant phone number</label>
              <input type="text" name="phone" value="<%= settings.phone %>">
            </div>
          </div>
          <button class="btn" type="submit" style="margin-top:14px;">Save settings</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
