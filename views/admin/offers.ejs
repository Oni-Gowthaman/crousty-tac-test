<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head') %>
</head>
<body class="admin">
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { active: 'offers' }) %>
    <div class="main">
      <div class="page-head">
        <div>
          <h1>Offers</h1>
          <p>Active offers are shown and applied automatically — customers never need a promo code.</p>
        </div>
      </div>

      <div class="panel">
        <h2>New offer</h2>
        <form method="POST" action="/admin/offers/new">
          <div class="form-grid">
            <div class="field">
              <label>Description (English)</label>
              <input type="text" name="description_en" placeholder="10% off your order" required>
            </div>
            <div class="field">
              <label>Description (French)</label>
              <input type="text" name="description_fr" placeholder="10% de réduction" required>
            </div>
            <div class="field">
              <label>Discount type</label>
              <select name="discount_type">
                <option value="percentage">Percentage off</option>
                <option value="fixed">Fixed amount off (€)</option>
              </select>
            </div>
            <div class="field">
              <label>Discount value</label>
              <input type="number" step="0.10" min="0" name="discount_value" required>
            </div>
            <div class="field">
              <label>Start date</label>
              <input type="date" name="start_date" required>
            </div>
            <div class="field">
              <label>End date</label>
              <input type="date" name="end_date" required>
            </div>
            <div class="field full checkbox-row">
              <input type="checkbox" name="is_active" id="offerActive" checked>
              <label for="offerActive" style="margin:0;">Active</label>
            </div>
          </div>
          <button class="btn" type="submit" style="margin-top:14px;">Create offer</button>
        </form>
      </div>

      <div class="panel">
        <h2>All offers</h2>
        <% if (!offers.length) { %>
          <div class="empty">No offers created yet.</div>
        <% } else { %>
          <table class="data-table">
            <thead><tr><th>Description</th><th>Discount</th><th>Dates</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% offers.forEach(function(o) { %>
                <tr>
                  <td><%= o.description_en %> / <%= o.description_fr %></td>
                  <td><%= o.discount_type === 'percentage' ? o.discount_value + '%' : '€' + Number(o.discount_value).toFixed(2) %></td>
                  <td><%= o.start_date %> → <%= o.end_date %></td>
                  <td>
                    <form method="POST" action="/admin/offers/<%= o.id %>/toggle" style="display:inline;">
                      <button type="submit" class="badge <%= o.is_active ? 'active' : 'inactive' %>" style="border:none;">
                        <%= o.is_active ? 'Active' : 'Inactive' %>
                      </button>
                    </form>
                  </td>
                  <td>
                    <form method="POST" action="/admin/offers/<%= o.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this offer?');">
                      <button type="submit" class="btn small secondary">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
